{
  "name": "kairos",
  "version": "1.0.0",
  "description": "Personal productivity app for task management, day planning, and focus tracking",
  "author": "Mohamed Ahmed",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zidan241/Kairos.git"
  },
  "homepage": "https://github.com/Zidan241/Kairos#readme",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun run server/index.ts",
    "dev:client": "vite",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build",
    "build:server": "bun build server/index.ts --compile --outfile dist/server",
    "package": "bun run build && electron-forge package",
    "make": "bun run build && electron-forge make",
    "start": "electron-forge start",
    "dev:electron": "concurrently \"bun run dev:server\" \"bun run dev:client\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron-forge start\"",
    "publish": "bun run build && dotenv -- electron-forge publish",
    "check": "tsc",
    "db:migrate": "drizzle-kit generate"
  },
